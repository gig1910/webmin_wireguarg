conf_dir=/etc/wireguard
backup_dir=/var/webmin/wireguard/backups
wg_cmd=/usr/bin/wg
wg_quick_cmd=/usr/bin/wg-quick
ip_cmd=/usr/sbin/ip
ping_cmd=/usr/bin/ping
traceroute_cmd=/usr/bin/traceroute
nc_cmd=/usr/bin/nc
stdbuf_cmd=/usr/bin/stdbuf
journalctl_cmd=/usr/bin/journalctl
qrencode_cmd=/usr/bin/qrencode
apt_get_cmd=/usr/bin/apt-get
dpkg_query_cmd=/usr/bin/dpkg-query
command_timeout=15
recent_handshake_seconds=180
stats_enabled=1
stats_refresh_interval=5
stats_live_window=900
stats_history_retention=86400
stats_live_retention=3600
analytics_enabled=1
analytics_retention_days=365
prometheus_enabled=0
prometheus_interval=60
prometheus_metrics=traffic,peer_state,handshake,collector
prometheus_traffic=1
prometheus_peer_state=1
prometheus_handshake=1
prometheus_events=0
prometheus_collector=1
prometheus_textfile_path=/var/lib/node_exporter/textfile_collector/webmin_wireguard.prom
stats_history_enabled=1
journal_lines=200
runtime_timeout=5

diagnostic_dir=/var/webmin/wireguard/diagnostics
diagnostic_retention=3600
diagnostic_idle_timeout=30
diagnostic_max_output=10485760
state_dir=/var/webmin/wireguard
max_config_bytes=4194304
backup_retention=30
stats_max_points=20000
stats_max_file_bytes=8388608
stats_max_total_bytes=268435456
stats_health_interval=30
diagnostic_max_jobs_per_user=2
systemctl_cmd=/usr/bin/systemctl

whois_cmd=/usr/bin/whois
geoiplookup_cmd=/usr/bin/geoiplookup
mmdblookup_cmd=/usr/bin/mmdblookup
geoip_city_db=
geoipupdate_cmd=/usr/bin/geoipupdate
geoipupdate_conf=/etc/GeoIP.conf
